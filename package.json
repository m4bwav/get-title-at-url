{
  "name": "get-title-at-url",
  "version": "3.0.0",
  "description": "Get the title of the web page at a URL. Zero dependencies, TypeScript, ESM and CommonJS, Node 20+.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4bwav/get-title-at-url.git"
  },
  "homepage": "https://github.com/m4bwav/get-title-at-url#readme",
  "bugs": {
    "url": "https://github.com/m4bwav/get-title-at-url/issues"
  },
  "author": "Mark Rogers (https://www.markdavidrogers.com)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "get-title-at-url": "./dist/cli.mjs"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "npm run build && npm run test:dist",
    "test:dist": "node --test test/unit/extract-title.test.js test/functional/get-title-at-url.test.js test/cli/cli.test.js test/package/shape.test.js",
    "test:consumers": "npm run build && node --test test/consumers/consumers.test.js",
    "test:live": "npm run build && node --test test/live/live.test.js",
    "coverage": "npm run build && c8 --check-coverage --lines 95 --branches 90 --exclude-after-remap --include \"src/**\" --reporter text --reporter lcov node --test test/unit/extract-title.test.js test/functional/get-title-at-url.test.js test/cli/cli.test.js",
    "lint": "xo",
    "typecheck": "tsc --noEmit",
    "check": "publint && attw --pack . && npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run check && npm test"
  },
  "files": [
    "dist",
    "!dist/cli.mjs.map",
    "CHANGELOG.md"
  ],
  "keywords": [
    "title",
    "page-title",
    "html",
    "url",
    "fetch",
    "og:title",
    "metadata",
    "scraper",
    "cli",
    "typescript",
    "esm",
    "cjs"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^24.13.6",
    "c8": "^12.0.0",
    "publint": "^0.3.24",
    "tsdown": "0.23.0",
    "typescript": "~6.0.3",
    "xo": "^5.0.1"
  }
}
